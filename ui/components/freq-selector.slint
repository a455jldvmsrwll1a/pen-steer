import { VerticalBox, ComboBox, LineEdit } from "std-widgets.slint";

export enum UpdateFrequencyMode {
    automatic,
    lockstep,
    fixed,
}

export component TickFrequencySelectWidget inherits VerticalBox {
    in-out property <UpdateFrequencyMode> mode;
    in-out property <float> fixed_rate;

    property <float> MAX_RATE: 10000.0;

    padding: 0;

    init => {
        let clamped = min(max(fixed_rate, 0.0), MAX_RATE);

        fixed_rate = clamped;
        freq_edit.display-pretty();
    }

    HorizontalLayout {
        padding: 0;
        spacing: 8px;

        Text {
            text: @tr("Update frequency:");
            vertical-alignment: center;
        }

        freq_combobox := ComboBox {
            model: [
                @tr("Automatic"),
                @tr("In lock-step with input"),
                @tr("Custom"),
                @tr("60 Hz"),
                @tr("133 Hz"),
                @tr("300 Hz"),
                @tr("1 kHz"),
            ];

            changed current-index => {
                let i = self.current-index;

                if i == 0 { mode = automatic; }
                else if i == 1 { mode = lockstep; }
                else { mode = fixed; }

                if i == 2 { /* do nothing */ }
                else if i == 3 { fixed_rate = 60; }
                else if i == 4 { fixed_rate = 133; }
                else if i == 5 { fixed_rate = 300; }
                else if i == 6 { fixed_rate = 1000; }
                else { fixed_rate = 60; }

                freq_edit.display-pretty();
            }
        }
    }

    HorizontalLayout {
        padding: 0;
        spacing: 4px;
        alignment: start;

        freq_desc_1 := Text {
            vertical-alignment: center;
            overflow: elide;
            wrap: word-wrap;
        }

        freq_edit := LineEdit {
            width: 100px;
            read-only: true;
            placeholder-text: @tr("... Hz");
            text: @tr("133 Hz");

            init => {
                display-pretty();
            }

            function display-pretty() {
                self.text = @tr("{} Hz", root.fixed_rate);
            }

            function display() {
                self.text = root.fixed_rate;
            }

            accepted(text) => {
                if text.is-float() {
                    self.clear-focus();

                    let value = text.to-float();
                    let clamped = min(max(value, 0.0), MAX_RATE);

                    root.fixed_rate = clamped;
                } else {
                    self.select-all();
                }
            }

            changed has-focus => {
                if self.has-focus {
                    // Needed to make sure that only the number itself is in the
                    // string once submitted by the user.
                    display();
                } else {
                    display-pretty();
                }
            }
        }

        freq_desc_2 := Text {
            vertical-alignment: center;
            overflow: elide;
            wrap: word-wrap;
        }

        states [
            automatic when freq_combobox.current-index == 0: {
                freq_desc_1.text: @tr("Tick rate is determined dynamically, depending on the input source.");
                freq_edit.visible: false;
                freq_edit.width: 0px;
                freq_edit.read-only: true;
                freq_desc_2.visible: false;
            }
            lockstep when freq_combobox.current-index == 1: {
                freq_desc_1.text: @tr("Ticks occur after every sample collected from the input. Not recommended when using physics.");
                freq_edit.visible: false;
                freq_edit.width: 0px;
                freq_edit.read-only: true;
                freq_desc_2.visible: false;
            }
            constant when freq_combobox.current-index >= 2: {
                freq_desc_1.text: @tr("Ticks occur at a fixed rate of ");
                freq_edit.visible: true;
                freq_edit.width: 100px;
                freq_edit.read-only: freq_combobox.current-value != "Custom";
                freq_desc_2.text: @tr(", independent of the input.");
                freq_desc_2.visible: true;
            }
        ]
    }
}
