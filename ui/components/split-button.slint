import {
    Button,
    HorizontalBox,
    Palette,
    StyleMetrics,
} from "std-widgets.slint";
import { SeparatorLine } from "separator-line.slint";

export component SplitButton inherits Rectangle {
    in property main_text <=> main_text_widget.text;
    in property <color> base_colour: Palette.control-background;
    in property <color> base_text_colour: Palette.control-foreground;

    callback main_clicked <=> main_touch.clicked;
    callback side_clicked <=> side_touch.clicked;

    background: Colors.transparent;
    min-width: main_text_widget.preferred-width + 60px;
    min-height: main_text_widget.preferred-height;
    forward-focus: main_focus_scope;

    HorizontalLayout {
        main_touch := TouchArea {
            horizontal-stretch: 0.6;

            main_rect := Rectangle {
                border-top-left-radius: 4px;
                border-bottom-left-radius: 4px;
                border-width: 1px;
                border-color: self.background.darker(25%);
                background: main_touch.pressed ? base_colour.darker(50%) : main_touch.has-hover ? base_colour.brighter(50%) : base_colour;

                main_focus_rect := Rectangle {
                    visible: false;
                    border-top-left-radius: 4px;
                    border-bottom-left-radius: 4px;
                    background: Colors.transparent;
                    border-color: #ffffff;
                    border-width: 2px;
                }

                animate background {
                    easing: ease-in;
                    duration: 0.1s;
                }

                main_text_widget := Text {
                    y: (parent.height - self.height) / 2;
                    color: main_touch.pressed ? base_text_colour.darker(25%) : base_text_colour;

                    animate color {
                        easing: ease-in;
                        duration: 0.1s;
                    }
                }
            }

            main_focus_scope := FocusScope {
                focus-gained(reason) => {
                    if reason != pointer-click {
                        main_focus_rect.visible = true;
                    }
                }

                focus-lost(reason) => {
                    main_focus_rect.visible = false;
                }

                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        main_clicked();
                        return accept;
                    } else {
                        return reject;
                    }
                }
            }
        }

        side_touch := TouchArea {
            horizontal-stretch: 0.4;

            side_rect := Rectangle {
                border-top-right-radius: 4px;
                border-bottom-right-radius: 4px;
                border-width: 1px;
                border-color: self.background.darker(25%);
                background: side_touch.pressed ? base_colour.darker(50%) : side_touch.has-hover ? base_colour.brighter(50%) : base_colour;

                side_focus_rect := Rectangle {
                    visible: false;
                    border-top-right-radius: 4px;
                    border-bottom-right-radius: 4px;
                    background: Colors.transparent;
                    border-color: #ffffff;
                    border-width: 2px;
                }

                animate background {
                    easing: ease-in;
                    duration: 0.1s;
                }

                Text {
                    y: (parent.height - self.height) / 2;
                    color: side_touch.pressed ? base_text_colour.darker(25%) : base_text_colour;
                    text: "...";

                    animate color {
                        easing: ease-in;
                        duration: 0.1s;
                    }
                }
            }

            FocusScope {
                focus-gained(reason) => {
                    if reason != pointer-click {
                        side_focus_rect.visible = true;
                    }
                }

                focus-lost(reason) => {
                    side_focus_rect.visible = false;
                }

                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        side_clicked();
                        return accept;
                    } else {
                        return reject;
                    }
                }
            }
        }
    }
}
