import {
    Button,
    HorizontalBox,
    Palette,
    StyleMetrics,
} from "std-widgets.slint";
import { SeparatorLine } from "separator-line.slint";

export component SplitButton inherits Rectangle {
    in property main-text <=> main-text-widget.text;
    in property <color> base-colour: Palette.control-background;
    in property <color> base-text-colour: Palette.control-foreground;

    callback main-clicked <=> main-touch.clicked;
    callback side-clicked <=> side-touch.clicked;

    background: Colors.transparent;
    min-width: main-text-widget.preferred-width + 60px;
    min-height: main-text-widget.preferred-height;
    forward-focus: main-focus-scope;

    HorizontalLayout {
        main-touch := TouchArea {
            horizontal-stretch: 0.6;

            main-rect := Rectangle {
                border-top-left-radius: 4px;
                border-bottom-left-radius: 4px;
                border-width: 1px;
                border-color: self.background.darker(25%);
                background: main-touch.pressed ? base-colour.darker(50%) : main-touch.has-hover ? base-colour.brighter(50%) : base-colour;

                main-focus-rect := Rectangle {
                    visible: false;
                    border-top-left-radius: 4px;
                    border-bottom-left-radius: 4px;
                    background: Colors.transparent;
                    border-color: #ffffff;
                    border-width: 2px;
                }

                animate background {
                    easing: ease-in;
                    duration: 0.1s;
                }

                main-text-widget := Text {
                    y: (parent.height - self.height) / 2;
                    color: main-touch.pressed ? base-text-colour.darker(25%) : base-text-colour;

                    animate color {
                        easing: ease-in;
                        duration: 0.1s;
                    }
                }
            }

            main-focus-scope := FocusScope {
                focus-gained(reason) => {
                    if reason != pointer-click {
                        main-focus-rect.visible = true;
                    }
                }

                focus-lost(reason) => {
                    main-focus-rect.visible = false;
                }

                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        main-clicked();
                        return accept;
                    } else {
                        return reject;
                    }
                }
            }
        }

        side-touch := TouchArea {
            horizontal-stretch: 0.4;

            side-rect := Rectangle {
                border-top-right-radius: 4px;
                border-bottom-right-radius: 4px;
                border-width: 1px;
                border-color: self.background.darker(25%);
                background: side-touch.pressed ? base-colour.darker(50%) : side-touch.has-hover ? base-colour.brighter(50%) : base-colour;

                side-focus-rect := Rectangle {
                    visible: false;
                    border-top-right-radius: 4px;
                    border-bottom-right-radius: 4px;
                    background: Colors.transparent;
                    border-color: #ffffff;
                    border-width: 2px;
                }

                animate background {
                    easing: ease-in;
                    duration: 0.1s;
                }

                Text {
                    y: (parent.height - self.height) / 2;
                    color: side-touch.pressed ? base-text-colour.darker(25%) : base-text-colour;
                    text: "...";

                    animate color {
                        easing: ease-in;
                        duration: 0.1s;
                    }
                }
            }

            FocusScope {
                focus-gained(reason) => {
                    if reason != pointer-click {
                        side-focus-rect.visible = true;
                    }
                }

                focus-lost(reason) => {
                    side-focus-rect.visible = false;
                }

                key-pressed(event) => {
                    if event.text == Key.Space || event.text == Key.Return {
                        side-clicked();
                        return accept;
                    } else {
                        return reject;
                    }
                }
            }
        }
    }
}
