import { VerticalBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { SeparatorLine } from "components/separator-line.slint";
import { TickFrequencySelectWidget } from "components/freq-selector.slint";
import { SteeringWheelConfigPanel } from "steering-wheel-config.slint";
import { ControlType, GlobalUiState } from "state.slint";

export component WheelTabContents inherits Rectangle {
    in-out property <ControlType> selected-type <=> GlobalUiState.control-config.active;

    init => {
        type_cb.set-type(selected-type);
    }

    changed selected-type => {
        type_cb.set-type(selected-type);
    }

    ScrollView {
        VerticalLayout {
            padding: 0;
            alignment: start;
            spacing: 1rem;

            Rectangle {
                height: 1rem;
            }

            update_freq_select := TickFrequencySelectWidget {
                mode <=> GlobalUiState.control-config.freq-mode;
                fixed_rate <=> GlobalUiState.control-config.fixed-freq;
            }

            Rectangle {
                height: 1rem;
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: @tr("Type:");
                    vertical-alignment: center;
                }

                type_cb := ComboBox {
                    model: [
                        "None",
                        "Steering wheel with horn",
                        "One-tablet driving",
                    ];

                    changed current-index => {
                        if self.current-index == 0 { selected-type = dummy; }
                        else if self.current-index == 1 { selected-type = steering-wheel; }
                        else if self.current-index == 2 { selected-type = one-tablet-drive; }
                    }

                    function set-type(type: ControlType) {
                        if type == dummy { type_cb.current-index = 0; }
                        else if type == steering-wheel { type_cb.current-index = 1; }
                        else if type == one-tablet-drive { type_cb.current-index = 2; }
                    }
                }
            }

            if selected-type == dummy: VerticalLayout {
                Text {
                    text: @tr("It ignores input and doesn't change any outputs. It in fact does nothing.");
                    overflow: elide;
                    wrap: word-wrap;
                }

                SeparatorLine { }

                Rectangle {
                    height: 100px;
                    Text {
                        text: @tr("No options available.");
                    }
                }
            }
            if selected-type == steering-wheel: SteeringWheelConfigPanel { }
            if selected-type == one-tablet-drive: VerticalLayout {

                Text {
                    text: @tr("Drag the pen side to side to turn the wheel. Moving the pen up (i.e. away from you) pushes down on the accelerator. Moving the pen down (i.e. towards you) pushes down on the brakes. Try not to crash.");
                    overflow: elide;
                    wrap: word-wrap;
                }

                SeparatorLine { }

                Rectangle {
                    height: 1rem;
                }

                Text {

                    text: @tr("One-tablet driving is WIP!!!");
                }
            }

            Rectangle {
                height: 1rem;
            }
        }
    }
}
