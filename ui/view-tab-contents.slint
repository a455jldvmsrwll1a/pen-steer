import { GlobalUiState } from "state.slint";
import { Palette, ProgressIndicator } from "std-widgets.slint";

export global ViewTabStatus {
    in property <float> steer-value;
    in property <float> ffb-value;
    in property <bool> ffb-available;
    in property <bool> pen-available;
    in property <float> pen-x;
    in property <float> pen-y;
    in property <float> grip-strength;
    in property <bool> horn-pressed;

    callback fetch-status();
}

export component ViewTabContents inherits Rectangle {
    in property <bool> show-steer-meter: true;
    in property <bool> show-ffb-meter: true;

    in-out property <bool> should-refresh;

    property <float> steer-value: ViewTabStatus.steer-value;
    // positive FFB value indicates counterclockwise torque, and vice-versa
    property <float> ffb-value: ViewTabStatus.ffb-value * -1.0;
    property <float> pen-x: ViewTabStatus.pen-x;
    property <float> pen-y: ViewTabStatus.pen-y;
    property <float> pen-pressure: ViewTabStatus.grip-strength;

    property <float> half-angle: GlobalUiState.control-config.steering-wheel.angle-range * 0.5;
    property <float> horn-radius: GlobalUiState.control-config.steering-wheel.horn-radius;

    // Not really what I wanted which is to request a redraw and invoke the
    // callback every frame, but this will do for now.
    refresh-timer := Timer {
        interval: 1s / 60;
        running: should-refresh;

        triggered => {
            ViewTabStatus.fetch-status();
        }
    }

    animate steer-value {
        duration: refresh-timer.interval;
        easing: linear;
    }

    VerticalLayout {
        Rectangle {
            min-height: 256px;
            vertical-stretch: 1;

            Rectangle {
                width: parent.width * 0.9;
                height: parent.height * 0.9;

                Image {
                    source: @image-url("../assets/base.svg");
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;

                    transform-rotation: steer-value * half-angle * 1deg;

                    horn-img := Image {
                        source: @image-url("../assets/inner.svg");
                        width: parent.width;
                        height: min(parent.height, parent.width) * (horn-radius / 100.0) * (ViewTabStatus.horn-pressed ? 0.85 : 1.0);
                        image-fit: contain;

                        Rectangle {
                            width: min(parent.width, parent.height);
                            height: self.width;
                            border-radius: self.height;
                            background: ViewTabStatus.horn-pressed ? purple.transparentize(0.5) : transparent;
                        }
                    }
                }

                if ViewTabStatus.pen-available: Rectangle {
                    background: pen-pressure > 0.0 ? lime : transparent;
                    border-width: parent.height * 0.0125;
                    border-color: limegreen;
                    border-radius: self.width / 2.0;
                    width: self.height;
                    height: min(parent.width, parent.height) * (0.1 - 0.05 * pen-pressure);
                    x: (parent.width * 0.5) - (self.width / 2) + (parent.height * 0.5 * pen-x);
                    y: (parent.height * 0.5) - (self.height / 2) - (parent.height * 0.5 * pen-y);
                }
            }
        }

        if show-ffb-meter: Rectangle {
            height: 23px;
            background: Palette.background.darker(50%);

            if ViewTabStatus.ffb-available: Rectangle {
                background: orange.darker(25%);
                height: parent.height;
                x: (parent.width / 2) * (1.0 + ffb-value.min(0.0));
                width: (parent.width / 2) * -ffb-value.min(0.0);
            }

            if ViewTabStatus.ffb-available: Rectangle {
                background: cyan.darker(25%);
                height: parent.height;
                x: parent.x + parent.width / 2;
                width: (parent.width / 2) * ffb-value.max(0.0);
            }

            if !ViewTabStatus.ffb-available: Text {
                text: @tr("FFB is not active!");
                color: Palette.foreground.darker(50%);
            }
        }

        if show-steer-meter && show-ffb-meter: Rectangle {
            height: 2px;
            background: Palette.border;
        }

        if show-steer-meter: Rectangle {
            height: 35px;
            background: Palette.background.darker(50%);

            Rectangle {
                background: red;
                height: parent.height;
                x: (parent.width / 2) * (1.0 + steer-value.min(0.0));
                width: (parent.width / 2) * -steer-value.min(0.0);
            }

            Rectangle {
                background: blue;
                height: parent.height;
                x: parent.x + parent.width / 2;
                width: (parent.width / 2) * steer-value.max(0.0);
            }
        }
    }
}
