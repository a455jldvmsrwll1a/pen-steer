import { UpdateFrequencyMode } from "components/freq-selector.slint";

export enum ControlType {
    dummy,
    steering-wheel,
    one-tablet-drive,
}

export enum InputBackend {
    null,
    net,
    linux-evdev,
    windows-wintab,
}

export enum OutputBackend {
    null,
    linux-uinput,
    windows-vigem,
    usb-over-ip,
}

export struct DummyConfig {}

export struct SteeringWheelConfig {
    angle-range: float = 1080.0,
    natural-rotation-radius-min: float,
    horn-radius: float = 40.0,
    pressure-min: float,
    pressure-max: float,
    ignore-exterior-input: bool,
    sticky-horn: bool,
    fast-mode-switch: bool,
    physics-enable: bool,
    inertia: float,
    spring-stiffness: float,
    damping-coeff: float,
    kinetic-friction-torque: float,
    static-friction-torque: float,
    allow-slippage: bool,
    auto-grip-force: bool,
    vary-grip-arm-length: bool,
    direct-grip-threshold: float,
    full-grip-force: float,
    enable-ffb: bool,
    full-ffb-negate: bool,
    full-ffb-force: float,
}

export struct OneTabletDriveConfig {}

export struct ControlConfig {
    active: ControlType = ControlType.steering-wheel,
    freq-mode: UpdateFrequencyMode = UpdateFrequencyMode.automatic,
    fixed-freq: float,
    dummy: DummyConfig,
    steering-wheel: SteeringWheelConfig,
    one-tablet-drive: OneTabletDriveConfig,
    input-backend: InputBackend = InputBackend.null,
    output-backend: OutputBackend = OutputBackend.null,
}

export struct NetInputBackendConfig {
    listen-address: string,
}

export struct NetInputBackendState {
    raw-message: string,
    origin: string,
    decoded-fields: [string],
}

export struct InputConfig {
    active: InputBackend = InputBackend.net,
    net-config: NetInputBackendConfig,
}

export global GlobalUiState {
    in-out property <ControlConfig> control-config;
    in-out property <InputConfig> input-config;

    callback ctl-config-changed();
    callback input-config-changed();

    changed control-config => {
        ctl-config-changed();
    }

    changed input-config => {
        input-config-changed();
    }
}
