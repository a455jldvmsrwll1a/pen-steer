import { SeparatorLine } from "components/separator-line.slint";
import {
    VerticalBox,
    Button,
    StandardButton,
    StyleMetrics,
} from "std-widgets.slint";

export component AboutWindow inherits Dialog {
    title: @tr("About pen-steer");

    VerticalBox {
        alignment: start;
        
        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                horizontal-stretch: 1;
                header_vl := VerticalLayout {

                    Text {
                        text: @tr("pen-steer");
                        font-weight: FontWeight.bold;
                        font-size: 24px;
                    }

                    Text {
                        text: @tr("Written by a455jldvmsrwll1a.");
                        font-size: 12px;
                    }

                    SeparatorLine { }
                }
            }

            Image {
                source: @image-url("../assets/icon.png");
                width: 96px;
                height: 96px;
                horizontal-stretch: 0;
                accessible-placeholder-text: @tr("pen-steer app icon");
                // horizontal-alignment: right;
                vertical-alignment: top;
            }
        }

        Text {
            text: @tr("(Ab)Use your graphics tablet as a virtual sim steering wheel. ('cause why not)");
        }

        Text {
            text: @tr("Draw circles to turn the steering wheel!");
        }

        VerticalBox { }
    }

    Button {
        text: @tr("Github");
        clicked => {
            Platform.open-url("https://github.com/a455jldvmsrwll1a/pen-steer");
        }
        dialog-button-role: action;
    }

    StandardButton {
        kind: ok;
        clicked => {
            root.close();
        }
    }
}
