import { VerticalBox, AboutSlint, StandardButton } from "std-widgets.slint";
import { SeparatorLine } from "components/separator-line.slint";

export component SlintWindow inherits Dialog {
    title: "#MadeWithSlint";

    VerticalBox {
        Text {
            text: @tr("pen-steer uses the Slint toolkit for its graphical user interface.");
        }

        SeparatorLine { }

        AboutSlint {
            preferred-height: 150px;
        }
    }

    StandardButton {
        kind: ok;
        clicked => {
            root.close();
        }
    }
}
