export { AboutWindow } from "about-window.slint";
export { SlintWindow } from "slint-window.slint";

import {
    AboutSlint,
    VerticalBox,
    Spinner,
    Button,
    StandardButton,
    TabWidget,
    Palette,
    StyleMetrics,
} from "std-widgets.slint";
import { SeparatorLine } from "separator-line.slint";
import { SplitButton } from "split-button.slint";

export component AppWindow inherits Window {
    in property <string> app_version: "<unknown>";
    in property <string> current_profile: "<unknown profile>";

    title: @tr("Pen Steer {} :: {}", app_version, current_profile);
    icon: @image-url("images/icon.png");
    min-width: 256px;
    min-height: 256px;

    callback show-about-app();
    callback show-about-slint();
    callback main_action_clicked <=> action_button.main_clicked;

    public function set_running_state(running: bool) {
        if running {
            action_button.base_colour = #d60000;
            action_button.main_text = @tr("Stop");
        } else {
            action_button.base_colour = #00d600;
            action_button.main_text = @tr("Start");
        }
    }

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Save");
            }

            MenuItem {
                title: @tr("Save as...");
            }

            MenuItem {
                title: @tr("Load...");
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Quit");
                activated => { root.close(); }
            }
        }

        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("About pen-steer");
                activated => { root.show-about-app(); }
            }

            MenuItem {
                title: @tr("About Slint");
                activated => { root.show-about-slint(); }
            }
        }
    }

    VerticalBox {
        TabWidget { }

        SeparatorLine { }

        HorizontalLayout {
            alignment: space-between;
            spacing: StyleMetrics.layout-spacing;

            HorizontalLayout {
                Text {
                    text: @tr("Input: {} Hz, sim: {} Hz, output: {} Hz", 69, 420, 727);
                    color: Colors.grey;
                    font-size: 18px;
                    vertical-alignment: bottom;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: @tr("Reset wheel");
                }

                action_button := SplitButton {
                    main_text: @tr("Start");
                    base_colour: #00d600;

                    side_clicked => {
                        menu_popup.show();
                    }
                }

                menu_popup := PopupWindow {
                    x: action_button.x - self.width + action_button.width;
                    y: action_button.y - self.height - StyleMetrics.layout-spacing;

                    Rectangle {
                        background: Palette.background;
                        border-color: Palette.border;
                        border-radius: 4px;
                        border-width: 1px;

                        VerticalLayout {
                            padding: StyleMetrics.layout-padding;
                            spacing: StyleMetrics.layout-spacing;

                            Text {
                                text: @tr("Start/stop systems independently.");
                            }

                            Button {
                                text: @tr("Start {} input", "evdev");
                            }

                            Button {
                                text: @tr("Start {} output", "uinput");
                            }
                        }
                    }
                }
            }
        }
    }
}
