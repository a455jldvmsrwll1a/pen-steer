export { AboutWindow } from "about-window.slint";
export { SlintWindow } from "slint-window.slint";

import {
    AboutSlint,
    VerticalBox,
    Spinner,
    Button,
    StandardButton,
    TabWidget,
    Palette,
    StyleMetrics,
    ComboBox,
    ScrollView,
    LineEdit,
} from "std-widgets.slint";
import { SeparatorLine } from "components/separator-line.slint";
import { SplitButton } from "components/split-button.slint";
import { TickFrequencySelectWidget } from "components/freq-selector.slint";
import { GlobalUiState } from "state.slint";
import { InputTabContents } from "config/input/tab-contents.slint";
import { WheelTabContents } from "config/control/wheel-tab-contents.slint";
import { HeadingText } from "components/heading-text.slint";
import { ViewTabContents, ViewTabStatus } from "view-tab-contents.slint";

export { GlobalUiState }
export { ViewTabStatus }
export component AppWindow inherits Window {
    in property <string> app-version: "<unknown>";
    in property <string> current-profile: "<unknown profile>";

    in-out property <bool> show-steer-meter: true;
    in-out property <bool> show-ffb-meter: true;
    in-out property <bool> always-show-perf-stats: true;

    title: @tr("pen-steer {} :: {}", app-version, current-profile);
    icon: @image-url("../assets/icon.png");
    preferred-width: 640px;
    preferred-height: 720px;

    property <bool> input-running: false;
    property <bool> output-running: false;
    property <bool> overall-running: input-running && output-running;

    callback show-about-app();
    callback show-about-slint();
    callback set-input-state-clicked(should-run: bool);
    callback set-output-state-clicked(should-run: bool);
    callback reset-wheel-state-clicked();

    public function on-input-state-changed(running: bool) {
        root.input-running = running;
    }

    public function on-output-state-changed(running: bool) {
        root.output-running = running;
    }

    MenuBar {
        Menu {
            title: @tr("File");

            MenuItem {
                title: @tr("Save");
            }

            MenuItem {
                title: @tr("Save as...");
            }

            MenuItem {
                title: @tr("Load...");
            }

            Menu {
                title: @tr("Revert");

                MenuItem {
                    title: @tr("From previously loaded configuration.");
                }

                MenuItem {
                    title: @tr("To defaults.");
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("Quit");
                activated => { root.close(); }
            }
        }

        Menu {
            title: @tr("System");

            MenuItem {
                title: @tr("Reset wheel state");

                activated => reset-wheel-state-clicked();
            }
        }

        Menu {
            title: @tr("View");

            MenuItem {
                title: @tr("View wheel in detached window");
                checkable: true;
                checked: false;
            }

            MenuItem {
                title: @tr("Show wheel angle bar");
                checkable: true;
                checked <=> root.show-steer-meter;
            }

            MenuItem {
                title: @tr("Show force-feedback meter");
                checkable: true;
                checked <=> root.show-ffb-meter;
            }

            MenuItem {
                title: @tr("Always show performance stats");
                checkable: true;
                checked <=> always-show-perf-stats;
            }
        }

        Menu {
            title: @tr("Help");

            MenuItem {
                title: @tr("About pen-steer");
                activated => { root.show-about-app(); }
            }

            MenuItem {
                title: @tr("About Slint");
                activated => { root.show-about-slint(); }
            }
        }
    }

    VerticalBox {
        spacing: 0;

        tabs := TabWidget {
            changed current-index => {
                view-tab-contents.should-refresh = self.current-index == 1;

                if view-tab-contents.should-refresh {
                    ViewTabStatus.fetch-status();
                }
            }

            Tab {
                title: @tr("Status");

                VerticalLayout {
                    alignment: center;

                    HeadingText {
                        horizontal-alignment: center;
                        text: @tr("Hello world! pen-steer {}", app-version);
                    }

                    Rectangle {
                        height: 5rem;
                    }

                    Text {
                        horizontal-alignment: center;
                        text: "Status page is work in progress!!!";
                    }
                }
            }

            Tab {
                title: @tr("View");

                view-tab-contents := ViewTabContents {
                    show-steer-meter: root.show-steer-meter;
                    show-ffb-meter: root.show-ffb-meter;
                }
            }

            Tab {
                title: @tr("Configuration");

                TabWidget {
                    Tab {
                        title: @tr("Control");

                        WheelTabContents { }
                    }

                    Tab {
                        title: @tr("Mapping");

                        Text {
                            text: "Mapping page is work in progress!!!";
                        }
                    }

                    Tab {
                        title: @tr("Input");

                        InputTabContents { }
                    }

                    Tab {
                        title: @tr("Output");

                        Text {
                            text: "Output page is work in progress!!!";
                        }
                    }

                    Tab {
                        title: @tr("Audio");

                        Text {
                            text: "Audio page is work in progress!!!";
                        }
                    }
                }
            }

            Tab {
                title: @tr("Console");

                Text {
                    text: "Console page is work in progress!!!";
                }
            }
        }

        SeparatorLine { }

        HorizontalLayout {
            alignment: space-between;
            spacing: StyleMetrics.layout-spacing;

            HorizontalLayout {
                Rectangle {
                    background: limegreen;
                    min-width: 80px;
                    border-radius: 3px;
                    visible: always-show-perf-stats || tabs.current-index == 0;

                    HorizontalLayout {
                        padding: 2px;
                        alignment: center;

                        Text {
                            text: @tr("{} Hz", 133);
                            font-size: 18px;
                            vertical-alignment: bottom;
                            overflow: elide;
                            wrap: no-wrap;
                        }
                    }

                    metrics-hover-ta := TouchArea { }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: @tr("Reset wheel");

                    clicked => reset-wheel-state-clicked();
                }

                action-button := SplitButton {
                    main-text: overall-running ? @tr("Stop") : @tr("Start");
                    base-colour: overall-running ? #d60000 : #00d600;

                    main-clicked => {
                        set-input-state-clicked(!overall-running);
                        set-output-state-clicked(!overall-running);
                    }

                    side-clicked => {
                        menu-popup.show();
                    }
                }

                menu-popup := PopupWindow {
                    x: action-button.x - self.width + action-button.width;
                    y: action-button.y - self.height - StyleMetrics.layout-spacing;
                    close-policy: close-on-click-outside;

                    Rectangle {
                        background: Palette.background;
                        border-color: Palette.border;
                        border-radius: 4px;
                        border-width: 1px;

                        VerticalLayout {
                            padding: StyleMetrics.layout-padding;
                            spacing: StyleMetrics.layout-spacing;

                            Text {
                                text: @tr("Start/stop systems independently.");
                            }

                            Button {
                                text: @tr("Start input");
                            }

                            Button {
                                text: @tr("Start output");
                            }
                        }
                    }
                }
            }
        }
    }

    metrics-popup := Rectangle {
        background: Palette.background;
        border-color: Palette.border;
        border-radius: 4px;
        border-width: 1px;
        visible: metrics-hover-ta.has-hover || metrics-hover-ta1.has-hover;
        width: metrics-popup-layout.preferred-width;
        height: metrics-popup-layout.preferred-height;
        x: StyleMetrics.layout-spacing;
        y: parent.height - self.height - StyleMetrics.layout-spacing - metrics-hover-ta.height;

        metrics-hover-ta1 := TouchArea { }

        metrics-popup-layout := VerticalLayout {
            alignment: start;
            padding: 8px;
            spacing: StyleMetrics.layout-spacing;

            Text {
                text: @tr("UI render: {} frames / second", 165);
            }

            Text {
                text: @tr("Update: {} ticks/ second", 133);
            }

            Text {
                text: @tr("Input: {} samples / second", 132);
            }

            Text {
                text: @tr("Output: {} events / second", 4);
            }
        }
    }

    if menu-popup.is-open: Rectangle {
        background: #000000BF;

        TouchArea {}
    }
}
