import {
    VerticalBox,
    ComboBox,
    LineEdit,
    Slider,
    StyleMetrics,
    CheckBox,
} from "std-widgets.slint";
import { SeparatorLine } from "../../components/separator-line.slint";
import { LabelledSoftSlider } from "../../components/soft-slider.slint";
import { HeadingText } from "../../components/heading-text.slint";
import { SteeringWheelConfig, GlobalUiState } from "../../state.slint";

export component SteeringWheelConfigPanel inherits VerticalBox {
    padding: 0;

    property <SteeringWheelConfig> config <=> GlobalUiState.control-config.steering-wheel;
    property <length> slider-label-width: 0px;

    public function refresh() {
        angular-range.refresh();
        base-radius.refresh();
        horn-radius.refresh();
        pressure-min.refresh();
        pressure-max.refresh();
        inertia.refresh();
        spring-stiffness.refresh();
        damping-coeff.refresh();
        kinetic-friction-torque.refresh();
        static-friction-torque.refresh();
        direct-grip-threshold.refresh();
        full-grip-force.refresh();
        full-ffb.refresh();
    }

    changed config => {
        refresh();
    }

    init => {
        slider-label-width = slider-label-width.max(angular-range.preferred-label-width);
        slider-label-width = slider-label-width.max(base-radius.preferred-label-width);
        slider-label-width = slider-label-width.max(horn-radius.preferred-label-width);
        slider-label-width = slider-label-width.max(pressure-min.preferred-label-width);
        slider-label-width = slider-label-width.max(pressure-max.preferred-label-width);
        slider-label-width = slider-label-width.max(inertia.preferred-label-width);
        slider-label-width = slider-label-width.max(spring-stiffness.preferred-label-width);
        slider-label-width = slider-label-width.max(damping-coeff.preferred-label-width);
        slider-label-width = slider-label-width.max(kinetic-friction-torque.preferred-label-width);
        slider-label-width = slider-label-width.max(static-friction-torque.preferred-label-width);
        slider-label-width = slider-label-width.max(direct-grip-threshold.preferred-label-width);
        slider-label-width = slider-label-width.max(full-grip-force.preferred-label-width);
        slider-label-width = slider-label-width.max(full-ffb.preferred-label-width);

        slider-label-width += 1.5rem;
    }

    Text {
        text: @tr("Turn the wheel by dragging the pen in a circular motion. To honk, press the pen down near the centre of the wheel.");
        overflow: elide;
        wrap: word-wrap;
    }

    Rectangle {
        height: 1rem;
    }

    SeparatorLine { }

    HeadingText {
        text: @tr("General Properties");
    }

    Rectangle {
        min-height: 256px;
        vertical-stretch: 1;

        Image {
            source: @image-url("../../../assets/base.svg");
            width: parent.width;
            height: parent.height;
            image-fit: contain;

            horn-img := Image {
                source: @image-url("../../../assets/inner.svg");
                width: parent.width;
                height: parent.height * (horn-radius.current-value / 100.0);
                image-fit: contain;
            }

            Rectangle {
                height: parent.height * (base-radius.current-value / 100.0);
                width: self.height;
                border-radius: self.height / 2;
                background: base-radius-control-ta.has-hover ? #b8edffcb : #00000000;
            }

            Rectangle {
                height: horn-img.height * 105%;
                width: self.height;
                border-radius: self.height / 2;
                background: horn-radius-control-ta.has-hover ? #00ff00a0 : #00000000;
            }
        }
    }

    Rectangle {
        height: 1rem;
    }

    Text {
        text: @tr("Tip: hover over the control items for more information.");

        Tooltip {
            text: @markdown("yea like that");
        }
    }

    angular-range := LabelledSoftSlider {
        label: @tr("Lock-to-lock range");
        hint: @tr("Range in degrees from extreme left to extreme right of the steering wheel.");
        label-width <=> slider-label-width;
        value-display-suffix: "°";
        value-soft-min: 180.0;
        value-soft-max: 1800.0;
        value-step: 30.0;
        value-hard-min: 1.0;
        value-hard-max: 999999.0;
        current-value <=> config.angle-range;
    }

    base-radius-control-ta := TouchArea {
        base-radius := LabelledSoftSlider {
            label: @tr("Base radius %");
            hint: @tr("Minimum percentage of the wheel radius for angular displacement calculations.\nCircling the pen closer than this will not cause the wheel to spin faster.\n\nThis can prevent issues when drawing off-centred circles, but if the pen is consistently too close,\nit will cause the wheel to turn slower than intended.");
            label-width <=> slider-label-width;
            value-display-suffix: "%";
            value-soft-min: 0.0;
            value-soft-max: 100.0;
            value-step: 5.0;
            value-hard-min: 0.0;
            value-hard-max: 100.0;
            current-value <=> config.natural-rotation-radius-min;
        }
    }

    horn-radius-control-ta := TouchArea {
        horn-radius := LabelledSoftSlider {
            label: @tr("Horn radius %");
            hint: @tr("Percentage of the radius of the steering wheel to use as the activation area for the horn.");
            label-width <=> slider-label-width;
            value-display-suffix: "%";
            value-soft-min: 0.0;
            value-soft-max: 100.0;
            value-step: 5.0;
            value-hard-min: 0.0;
            value-hard-max: 100.0;
            current-value <=> config.horn-radius;
        }
    }

    pressure-min := LabelledSoftSlider {
        label: @tr("Min. pressure %");
        hint: @tr("Lower bound of the grip strength range.\n\nThis is also the minimum pressure the pen must be held down with for it to be considered as such.");
        label-width <=> slider-label-width;
        value-display-suffix: "%";
        value-soft-min: 0.0;
        value-soft-max: 100.0;
        value-step: 5.0;
        value-hard-min: 0.0;
        value-hard-max: pressure-max.current-value;
        current-value <=> config.pressure-min;
    }

    pressure-max := LabelledSoftSlider {
        label: @tr("Max. pressure %");
        hint: @tr("Upper bound of the grip strength range.\n(a.k.a. gripping the wheel as hard as possible)\n\nThis setting is irrelevant unless physics and slippage are both enabled.");
        label-width <=> slider-label-width;
        value-display-suffix: "%";
        value-soft-min: 0.0;
        value-soft-max: 100.0;
        value-step: 5.0;
        value-hard-min: pressure-min.current-value;
        value-hard-max: 100.0;
        current-value <=> config.pressure-max;
    }

    Rectangle {
        height: 1rem;
    }

    ignore-exterior-input := CheckBox {
        text: @tr("Ignore pen when outside the circle");
        checked <=> config.ignore-exterior-input;

        Tooltip {
            text: @markdown("Treat the pen as up when not within the circle. (i.e. when distance to centre is > 1)");
        }
    }

    sticky-horn := CheckBox {
        text: @tr("Use horn as toggle");
        checked <=> config.sticky-horn;

        Tooltip {
            text: @markdown("If checked, pressing the horn toggles it. Otherwise it acts like a normal horn pad.");
        }
    }

    fast-mode-switch := CheckBox {
        text: @tr("Fast switching between honking and steering");
        checked <=> config.fast-mode-switch;

        Tooltip {
            text: @markdown("\{"If enabled, you do not need to lift up the pen (i.e. stop what you are doing)\nbefore switching between honking and steering.\n\nIf you are steering and the pen enters the horn area,\nit will immediately activate and you will stop steering until the pen leaves the horn area.\n\nIf disabled, you must lift up the pen."}");
        }
    }

    Rectangle {
        height: 1rem;
    }

    SeparatorLine { }

    HeadingText {
        text: @tr("Physical Properties");
    }

    Text {
        text: @tr("Steering wheel auto-centring, slipping, and force-feedback all rely on a physics simulation.");
    }

    Rectangle {
        height: 1rem;
    }

    physics-enable := CheckBox {
        text: @tr("Enable physics");
        checked <=> config.physics-enable;

        Tooltip {
            text: @markdown("\{"Simulate forces on the wheel, affecting its angular position and its angular velocity.\n\nIf disabled, the wheel only rotates when dragged, and never moves otherwise."}");
        }
    }

    inertia := LabelledSoftSlider {
        label: @tr("Moment of inertia");
        hint: @tr("A low inertia means the wheel is more responsive to forces, especially from force feedback.\n\nThe acceleration of the wheel is inversly proportional to its inertia: α = τ/J.\n\nIf mass M in kilograms and radius R in metres is known, then it can be approximated as\nJ = MR² (in kgm²).");
        label-width <=> slider-label-width;
        value-display-suffix: " kgm²";
        value-soft-min: 0.1;
        value-soft-max: 100.0;
        value-step: 1.0;
        value-hard-min: 0.001;
        value-hard-max: 1000000.0;
        current-value <=> config.inertia;
        enabled: physics-enable.checked;
    }

    spring-stiffness := LabelledSoftSlider {
        label: @tr("Spring stiffness");
        hint: @tr("Determines the strength of the spring that twists the wheel back to its neutral position.\nKeep it at zero if this auto-centring behaviour is undesired.\n\nIf non-zero, you should also set a reasonable friction coefficient,\nwhich will help stop the wheel from overshooting and oscillating.\n\nThe torque the spring stiffness (k) contributes depends on the wheel's angle (θ):\n\nτ = - kθ");
        label-width <=> slider-label-width;
        value-display-suffix: " Nm/rad";
        value-soft-min: 0.0;
        value-soft-max: 50.0;
        value-step: 0.1;
        value-hard-min: -100000.0;
        value-hard-max: 1000000.0;
        current-value <=> config.spring-stiffness;
        enabled: physics-enable.checked;
    }

    damping-coeff := LabelledSoftSlider {
        label: @tr("Damping coefficient");
        hint: @tr("A higher damping coefficient slows down the wheel more and damps its movement.\nA coefficient of zero makes the wheel glide forever,\nunless influenced by spring force and/or force feedback.\n\nThe damping coefficient (μ-v) is a dimensionless quantity.\nThe torque it contributes depends on the wheel's velocity (ω):\n\nτ-v = - (μ-v)ω");
        label-width <=> slider-label-width;
        value-soft-min: 0.0;
        value-soft-max: 50.0;
        value-step: 0.1;
        value-hard-min: -100000.0;
        value-hard-max: 1000000.0;
        current-value <=> config.damping-coeff;
        enabled: physics-enable.checked;
    }

    kinetic-friction-torque := LabelledSoftSlider {
        label: @tr("Kinetic friction torque");
        hint: @tr("A constant torque applied when the wheel is in motion.\nIt is applied opposing the direction of rotation.\n\nThis is irrelevant when the wheel is stationary.\n\nThe torque contributed depends only on the sign of the wheel's velocity (ω):\n\nτ-k = - (T-k)sgn(ω)");
        label-width <=> slider-label-width;
        value-display-suffix: " Nm";
        value-soft-min: 0.0;
        value-soft-max: 30.0;
        value-step: 0.1;
        value-hard-min: -100000.0;
        value-hard-max: 1000000.0;
        current-value <=> config.kinetic-friction-torque;
        enabled: physics-enable.checked;
    }

    static-friction-torque := LabelledSoftSlider {
        label: @tr("Max static friction torque");
        hint: @tr("The maximum torque that resists movement from the wheel when stationary.\nWhen this torque is insufficient, the wheel will break free and start rotating.\nThis is irrelevant when the wheel is rotating.\nThe torque (τ-s) contributed is equal and opposite to whatever is trying to move the wheel, up to the maximum:\n\nτ-s <= T-s");
        label-width <=> slider-label-width;
        value-display-suffix: " Nm";
        value-soft-min: 0.0;
        value-soft-max: 50.0;
        value-step: 0.5;
        value-hard-min: -100000.0;
        value-hard-max: 1000000.0;
        current-value <=> config.static-friction-torque;
        enabled: physics-enable.checked;
    }

    Rectangle {
        height: 1rem;
    }

    allow-slippage := CheckBox {
        text: @tr("Allow slippage");
        checked <=> config.allow-slippage;
        enabled: physics-enable.checked;

        Tooltip {
            text: @markdown("\{"When enabled, the pen turns the wheel by supplying it a torque,\nleaving it to physics to actually turn it.\nThis allows the steering wheel to slip.\n\nOtherwise, the steering wheel is directly turned by the pen."}");
        }
    }

    auto-grip-force := CheckBox {
        text: @tr("Automatically determine maximum grip torque");
        checked <=> config.auto-grip-force;
        enabled: physics-enable.checked && allow-slippage.checked;

        Tooltip {
            text: @markdown("Calculate the torque required. //TODO: what? WIP. this section is not supper accurate and  its 1 a.m.");
        }
    }

    vary-grip-arm-length := CheckBox {
        text: @tr("Allow grip torque to vary by distance from centre");
        checked <=> config.vary-grip-arm-length;
        enabled: physics-enable.checked && allow-slippage.checked;

        Tooltip {
            text: @markdown("Scale the torque proportional to the distance of the grip point.\n\nIf disabled, the grip point is assumed to be at r = 1.");
        }
    }

    direct-grip-threshold := LabelledSoftSlider {
        label: @tr("Direct grip %");
        hint: @tr("Percentage threshold of the grip strength required for the grip to be considered direct.\n\nThe grip strength is a percentage of the configured pressure range with\n0% strength up to the minimum pressure % and 100% strength at the maximum pressure %.");
        label-width <=> slider-label-width;
        value-display-suffix: "%";
        value-soft-min: 0.0;
        value-soft-max: 100.0;
        value-step: 5.0;
        value-hard-min: 0.0;
        value-hard-max: 100.0;
        current-value <=> config.direct-grip-threshold;
        enabled: physics-enable.checked && allow-slippage.checked;
    }

    full-grip-force := LabelledSoftSlider {
        label: @tr("Full grip torque");
        hint: @tr("Maximum torque applied to the steering wheel when gripping at full strength.\n\nThis figure assumes the grip point is at r = 1.\n\nThis setting is disabled when automatically calculating max grip torque.");
        label-width <=> slider-label-width;
        value-display-suffix: " Nm";
        value-soft-min: 0.0;
        value-soft-max: 200.0;
        value-step: 1.0;
        value-hard-min: -100000.0;
        value-hard-max: 1000000.0;
        current-value <=> config.full-grip-force;
        enabled: physics-enable.checked && allow-slippage.checked && !auto-grip-force.checked;
    }

    Rectangle {
        height: 1rem;
    }

    enable-ffb := CheckBox {
        text: @tr("Enable force-feedback");
        checked <=> config.enable-ffb;
        enabled: physics-enable.checked;

        Tooltip {
            text: @markdown("Respond to FFB values when simulating the steering wheel physics.");
        }
    }

    full-ffb-negate := CheckBox {
        text: @tr("Apply opposite torque");
        checked <=> config.full-ffb-negate;
        enabled: physics-enable.checked && enable-ffb.checked;

        Tooltip {
            text: @markdown("\{"Apply force-feedback in the opposite direction.\n\nNormally, a positive FFB value produces a counter-clockwise torque.\nWith this option enabled, the same value produces a clockwise torque.\n\nUseful if the incoming value is flipped by the game."}");
        }
    }

    full-ffb := LabelledSoftSlider {
        label: @tr("Full FFB torque");
        hint: @tr("The torque (in Newton-metres) produced when receiving the max FFB value.\n\ne.g. at 100% ffb value, this much torque is applied.");
        label-width <=> slider-label-width;
        value-display-suffix: " Nm";
        value-soft-min: 0.0;
        value-soft-max: 200.0;
        value-step: 5.0;
        value-hard-min: -100000.0;
        value-hard-max: 1000000.0;
        current-value <=> config.full-ffb-force;
        enabled: physics-enable.checked && enable-ffb.checked;
    }
}
